# CloudLinux NodeJS Selector (cPanel) defaults to omitting devDependencies
# (npm config get omit -> "dev"), even for a plain `npm install`/`npm ci` with
# no flags. tsx, typescript, eslint and prisma's CLI are devDependencies this
# project genuinely needs at build/deploy time (prisma generate, tsx for
# seeding, next build), so without this override every fresh install on that
# host silently ends up missing them.
include=dev
