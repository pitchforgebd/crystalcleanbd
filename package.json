{
  "name": "crystal-clean-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "node -e \"const cp=require('child_process');const path=require('path');const fs=require('fs');const root=process.env.INIT_CWD||process.cwd();const schema=path.join(root,'prisma','schema.prisma');const pkgJson=require.resolve('prisma/package.json',{paths:[root]});const pkg=JSON.parse(fs.readFileSync(pkgJson,'utf8'));const cli=path.join(path.dirname(pkgJson),typeof pkg.bin==='string'?pkg.bin:pkg.bin.prisma);cp.execFileSync(process.execPath,[cli,'generate','--schema',schema],{stdio:'inherit',cwd:root});\"",
    "start:cpanel": "node server.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "framer-motion": "^13.2.0",
    "next": "16.3.3",
    "nodemailer": "^10.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
