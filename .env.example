# ------------------------------------------------------------------
# Crystal Clean Service — environment variables (EXAMPLE / template)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Database (Phase 2) ---
# Local development with Laragon MySQL (default user "root", empty password).
# If your Laragon MySQL has a password, put it between ":" and "@".
DATABASE_URL="mysql://root:@127.0.0.1:3306/crystal_clean"

# Production (cPanel MySQL) — user/db are usually prefixed with your cPanel account name:
# DATABASE_URL="mysql://cpaneluser_dbuser:STRONG_PASSWORD@localhost:3306/cpaneluser_crystal_clean"

# --- Auth (Phase 3) ---
# Signs the admin session cookie. Minimum 32 characters; rotating it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Seeded owner account — `npm run db:seed` creates/updates this admin.
# Set ADMIN_PASSWORD (min 8 chars) before seeding, then remove it from the file.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Site Owner"
ADMIN_PASSWORD=""

# --- Contact form email (SMTP) ---
# Leave SMTP_HOST or CONTACT_TO_EMAIL empty to disable delivery: messages are
# still stored in the admin dashboard, they are just not emailed.
# cPanel: host = mail.yourdomain.com, port 465 (SSL) or 587 (TLS),
# user = a real mailbox you created, e.g. info@yourdomain.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # true for port 465
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_FROM_EMAIL=""        # defaults to SMTP_USER
CONTACT_TO_EMAIL=""          # where new enquiries are delivered
CONTACT_AUTOREPLY="true"     # also send the visitor a "we received it" email
SITE_URL=""                  # used for the "Open in admin" link in the email

# --- Admin media uploads ---
# Where uploaded images are stored. Defaults to ./uploads next to the app.
# Keep this folder when redeploying — it holds the client's photos.
UPLOAD_DIR=""
